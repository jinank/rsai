---
import type { AppEntry } from '../lib/apps';
import { categoryEmoji, verdictCopy } from '../lib/apps';
interface Props { app: AppEntry; featured?: boolean }
const { app, featured = false } = Astro.props;
---
<article class:list={["kit-card", { spotlight: featured }]}>
  <div class="kit-card-top"><span>{categoryEmoji[app.category]} {app.category}</span><span class:list={["verdict", `verdict-${app.verdict}`]}>{verdictCopy[app.verdict].short}</span></div>
  <div class="kit-app"><img class="favicon" src={`https://${app.domain}/favicon.ico`} alt="" /><div><h3>{app.name} launch kit</h3><p>Built for {app.targetBuyer?.toLowerCase()}</p></div></div>
  <div class="kit-meta"><span><b>{app.buildTime}</b> estimated build</span><span><b>${app.kitPrice}</b> one time</span></div>
  <ul>{app.deliverables?.slice(0, 3).map((item) => <li>{item}</li>)}</ul>
  <div class="kit-actions"><a class="button" href={`/buy/${app.slug}`}>GET THE KIT</a><a href={`/demos/${app.slug}`}>LIVE PREVIEW ↗</a></div>
</article>
