---
import BaseLayout from '../layouts/BaseLayout.astro';
import { opportunities } from '../lib/opportunities';

const title = 'Browse All Software Apps | Rethinksoft';
const description = 'Browse ready-to-brand software businesses from Rethinksoft. Search by product, customer, or category and follow new app launches.';
const categories = [...new Set(opportunities.map((item) => item.category))].sort();
const palette = ['mint', 'peach', 'blue', 'lilac', 'sand', 'rose', 'sky', 'lime'];
const shortTitles: Record<string, string> = {
  'ai-interview-coach': 'Interview AI',
  'proposal-copilot': 'Proposal Copilot',
  'local-review-ops': 'Review Ops',
  'vertical-ai-receptionist': 'AI Receptionist',
  'niche-job-board': 'Job Board',
  'property-document-assistant': 'Property Docs',
  'course-support-agent': 'Course Support',
  'invoice-chase-assistant': 'Invoice Chase',
};
---
<BaseLayout {title} {description} pageClass="hub-page app-catalog-page">
  <section class="catalog-hero">
    <div class="foundry-grid" aria-hidden="true"></div>
    <div class="container catalog-hero-inner">
      <p class="catalog-kicker"><span>▦</span> SOFTWARE BUSINESS CATALOG</p>
      <h1>Browse <em>apps.</em></h1>
      <p>Choose a product to brand and sell. We handle the technology.</p>
      <div class="catalog-hero-actions"><a href="#all-apps">BROWSE ALL APPS <span>↓</span></a><a href="/#pricing">VIEW PLANS</a></div>
    </div>
  </section>

  <section class="catalog-shell container" id="all-apps">
    <aside class="catalog-sidebar">
      <label class="catalog-search"><span>⌕</span><input type="search" data-opportunity-search placeholder="Search apps" aria-label="Search software apps" /></label>
      <nav aria-label="Filter software apps">
        <p>BROWSE</p>
        <button class="active" type="button" data-opportunity-category="all">All apps <span>{opportunities.length}</span></button>
        {categories.map((category) => <button type="button" data-opportunity-category={category.toLowerCase()}>{category}<span>{opportunities.filter((item) => item.category === category).length}</span></button>)}
      </nav>
      <div class="catalog-sidebar-note"><span>50+</span><p>software businesses planned for the Rethinksoft fleet</p></div>
    </aside>

    <div class="catalog-results">
      <div class="catalog-results-head"><div><p>ALL SOFTWARE</p><h2>Browse all apps</h2></div><span>Showing <b data-opportunity-count>{opportunities.length}</b> apps</span></div>
      <div class="catalog-mobile-filters" aria-label="Filter software apps on mobile"><button class="active" type="button" data-opportunity-category="all">All</button>{categories.map((category) => <button type="button" data-opportunity-category={category.toLowerCase()}>{category}</button>)}</div>
      <div class="catalog-grid" data-opportunity-list>
        {opportunities.map((item, index) => (
          <a class="catalog-card reveal" href={`/start?opportunity=${item.slug}`} data-opportunity-item data-search={`${item.name} ${item.category} ${item.audience} ${item.summary}`.toLowerCase()} data-category={item.category.toLowerCase()}>
            <div class:list={['catalog-preview', `preview-${palette[index % palette.length]}`]}>
              <div class="preview-window"><div class="preview-bar"><i></i><i></i><i></i><span>{item.displayName || shortTitles[item.slug]}</span></div><div class="preview-body"><aside><b>{item.name.slice(0, 1)}</b><i></i><i></i><i></i></aside><main><div class="preview-title"><i></i><i></i></div><div class="preview-metrics"><span></span><span></span><span></span></div><div class="preview-chart"><i></i><i></i><i></i><i></i><i></i></div></main></div></div>
              <div class="catalog-tags"><span>{item.category}</span><span>Managed software</span></div>
              <b class:list={['app-status', item.status === 'live' && 'live']}>{item.status === 'live' ? 'LIVE' : 'COMING SOON'}</b>
            </div>
            <div class="catalog-card-copy"><h3>{item.displayName || shortTitles[item.slug]}</h3><p>{item.summary}</p><div><span>FOR {item.audience}</span><strong>{item.status === 'live' ? 'EXPLORE' : 'VIEW APP'} <i>→</i></strong></div></div>
          </a>
        ))}
      </div>
      <p class="opportunity-empty" data-opportunity-empty hidden>No apps match your search.</p>
    </div>
  </section>

  <section class="catalog-final"><div class="container"><div><p>CAN'T FIND YOUR SOFTWARE?</p><h2>Tell us what to<br />build next.</h2></div><a href="/start"><span>→</span> REQUEST AN APP</a></div></section>
</BaseLayout>
