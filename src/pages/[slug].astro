---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryEmoji, getApp, getApps, verdictCopy } from '../lib/apps';
import { getVoteCounts } from '../lib/db';

const app = getApp(Astro.params.slug || '');
if (!app) return Astro.redirect('/404');
const allApps = getApps();
const counts = getVoteCounts();
const related = allApps.filter((item) => item.slug !== app.slug).sort((a, b) => Number(b.category === app.category) - Number(a.category === app.category)).slice(0, 3);
const verdict = verdictCopy[app.verdict];
const isPromptLocked = app.verdict === 'yes' || app.verdict === 'kinda';
const title = `How Do You Build a ${app.name} Style Product? | Rethinksoft`;
const description = isPromptLocked
  ? `${verdict.label}. Preview the product blueprint and unlock the premium agent prompt to build, customize, and launch your own version.`
  : `${verdict.label}. Copy an agent ready product prompt and explore proven open source codebases to build, customize, and launch your own version.`;
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const url = `${siteUrl}/${app.slug}`;
const faqs = [
  { q: `Can I build a ${app.name} style product with this prompt?`, a: app.verdict === 'yes' ? `Yes. The prompt is scoped to a valuable core workflow that a capable coding agent can turn into a strong first product.` : app.verdict === 'kinda' ? `Yes, if you begin with the focused core and plan additional work for integrations, scale, and product polish.` : `You can build a focused version for a specific niche. A broad platform at the same scale requires experienced engineering and operations.` },
  { q: 'Which AI coding agent should I use?', a: 'Use the agent that can inspect files, run commands, and iterate on errors. Claude Code, Codex, and Cursor are all suitable; the copy buttons add tailored instructions.' },
  { q: 'Can I sell the product I build?', a: 'You can sell your own original product, but review the licenses of any open source code you use and avoid copying protected branding, content, or proprietary assets.' },
  { q: 'Is the generated app ready to launch?', a: 'Treat the first output as a strong foundation. Review authentication, billing, backups, privacy, accessibility, security, and failure modes before serving paying customers.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: app.category, item: `${siteUrl}/#death-list` },
    { '@type': 'ListItem', position: 3, name: app.name, item: url },
  ] },
];
---
<BaseLayout {title} {description} image={`/og/${app.slug}.png`} {jsonLd}>
  <div class="container crumbs"><a href="/">HOME</a> / <a href="/#death-list">{app.category.toUpperCase()}</a> / <span>{app.name.toUpperCase()}</span></div>
  <section class="detail-hero">
    <div class="container">
      <div class="detail-top">
        <div><div class="detail-brand"><img class="favicon" src={`https://${app.domain}/favicon.ico`} alt="" /><div><p class="eyebrow">Product blueprint #{String(allApps.findIndex((item) => item.slug === app.slug) + 1).padStart(3, '0')}</p><span>{app.domain} · ${app.priceMonthly}/month market reference</span></div></div><h1>{app.name}</h1></div>
        <div class="verdict-display"><p class="eyebrow">Recommended build scope</p><div class:list={["verdict-big", app.verdict]}>{verdict.kicker}</div></div>
      </div>
      <div class="detail-summary"><p>{app.notes}</p><div class="metric-box"><div class="metric"><strong>${app.priceMonthly}</strong><span>MARKET PRICE</span></div><div class="metric"><strong>{counts[app.slug] || 0}</strong><span>BUILDER LAUNCHES</span></div></div></div>
    </div>
  </section>

  <div class="container detail-grid">
    <article>
      <section class="block reveal" id="prompt"><div class="block-head"><div><p class="eyebrow">Your product starting point</p><h2>AGENT BUILD PROMPT</h2></div><p>{isPromptLocked ? 'PREMIUM PROMPT LOCKED' : 'READY FOR AGENTIC CODING'}</p></div>
        {isPromptLocked ? (
          <div class="prompt-lock">
            <div class="prompt-lock-icon" aria-hidden="true">⌁</div>
            <p class="eyebrow">Premium access</p>
            <h3>Unlock the complete {verdict.short.toLowerCase()} prompt.</h3>
            <p>The full build specification and agent specific copy controls are reserved for premium members. Choose a plan to get launch access.</p>
            <a class="button" href="/#pricing">VIEW PRICING ↗</a>
          </div>
        ) : (
          <>
            <div class="code-wrap"><div class="code-toolbar"><span class="dots"><i></i><i></i><i></i></span><span>{app.slug}-product.prompt</span><span>Launch specification</span></div><pre id="build-prompt">{app.prompt}</pre></div>
            <div class="agent-buttons">
              <button class="copy-button" type="button" data-agent="claude" data-prompt={app.prompt}>⌁ COPY FOR CLAUDE CODE</button>
              <button class="copy-button" type="button" data-agent="codex" data-prompt={app.prompt}>⌁ COPY FOR CODEX</button>
              <button class="copy-button" type="button" data-agent="cursor" data-prompt={app.prompt}>⌁ COPY FOR CURSOR</button>
            </div>
          </>
        )}
      </section>

      <section class="block reveal"><div class="block-head"><div><p class="eyebrow">Plan for the hard parts</p><h2>WHAT STILL NEEDS WORK</h2></div></div><ul class="loss-list">{app.whatYouLose.map((loss) => <li>{loss}</li>)}</ul></section>
      <section class="block reveal"><div class="block-head"><div><p class="eyebrow">Scope it intelligently</p><h2>BUILD STRATEGY</h2></div></div><p class="notes">{app.notes}</p></section>
      <section class="block reveal"><div class="block-head"><div><p class="eyebrow">Start with proven code</p><h2>OPEN SOURCE CODEBASES</h2></div></div><div class="prior-links">{app.priorArt.map((item) => <a href={item.url} target="_blank" rel="noopener"><span>{item.title}</span><span>EXPLORE SOURCE ↗</span></a>)}</div></section>
      <section class="block reveal"><div class="block-head"><div><p class="eyebrow">Find another opportunity</p><h2>Related blueprints</h2></div></div><div class="related-grid">{related.map((item) => <a class="related" href={`/${item.slug}`}><img class="favicon" src={`https://${item.domain}/favicon.ico`} alt="" /><h3>{item.name}</h3><p>{categoryEmoji[item.category]} {item.category} · ${item.priceMonthly}/mo market</p><span class:list={["verdict", `verdict-${item.verdict}`]}>{verdictCopy[item.verdict].short}</span></a>)}</div></section>
      <section class="block faq reveal"><div class="block-head"><div><p class="eyebrow">Before you launch</p><h2>FAQ</h2></div></div>{faqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
    </article>
    <aside>
      <div class="side-card"><p class="eyebrow">Built by the community</p><h3>DID YOU BUILD IT?</h3><p>Count your launch when you have a working version that someone else can use.</p><button class="button vote-button" type="button" data-vote={app.slug}>▲ I BUILT THIS · <span>{counts[app.slug] || 0}</span></button><button class="button secondary share-button" type="button" data-share data-url={url} data-text={`I found a ready to use ${app.name} product blueprint on Rethinksoft. ${verdict.label}.`}>𝕏 SHARE THE BLUEPRINT</button><p class="form-note" data-vote-note aria-live="polite">ONE BUILD PER NETWORK.</p></div>
    </aside>
  </div>
</BaseLayout>
