---
import BaseLayout from '../layouts/BaseLayout.astro';
import KitCard from '../components/KitCard.astro';
import { getApps } from '../lib/apps';
const kits = getApps().filter((app) => app.featured);
const title = 'Launch Ready Software Kits | Rethinksoft';
const description = 'Buy complete software launch kits with agent prompts, open source implementation maps, positioning, launch copy, and growth plans.';
---
<BaseLayout {title} {description}>
  <section class="store-hero"><div class="container"><p class="eyebrow">The productized build library</p><h1>Start with more<br />than a <em>prompt.</em></h1><p>Each launch kit combines a complete agent specification, proven source foundations, commercial positioning, and the assets needed to find your first customers.</p><div class="hero-actions"><a class="button" href="#launch-kits">Browse launch kits</a><a class="text-link" href="/sell">Submit a working product ↗</a></div></div></section>
  <section class="section container" id="launch-kits"><div class="section-head"><div><p class="eyebrow">Five founding releases</p><h2>Pick a business to launch.</h2></div><p>One-time purchases with clear scope. No subscription is required to own and customize your kit.</p></div><div class="kit-grid">{kits.map((app, index) => <KitCard {app} featured={index === 0} />)}</div></section>
  <section class="proof-band"><div class="container"><p class="eyebrow">What every kit includes</p><div class="proof-grid"><article><strong>01</strong><h3>Build specification</h3><p>A production-focused prompt structured for Claude Code, Codex, and Cursor.</p></article><article><strong>02</strong><h3>Source map</h3><p>Proven open source foundations with guidance on what to reuse and what to replace.</p></article><article><strong>03</strong><h3>Commercial launch</h3><p>Positioning, pricing, landing page copy, SEO direction, and a launch calendar.</p></article></div></div></section>
</BaseLayout>
