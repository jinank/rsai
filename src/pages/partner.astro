---
import BaseLayout from '../layouts/BaseLayout.astro';
const partnerships=[['Capital Partners','Support technical founders with proof-linked capital and follow-on relationships.'],['Distribution Partners','Help strong products reach customers through channels, communities, and commercial introductions.'],['Technology Partners','Provide infrastructure, credits, tooling, or technical expertise to Foundry companies.'],['Talent Partners','Connect exceptional engineers, designers, operators, and advisors with early teams.']];
const title='Become a Rethinksoft Partner | Support Technical Founders';
const description='Partner with Rethinksoft to support AI-native technical founders with capital, distribution, technology, and talent.';
---
<BaseLayout {title} {description} pageClass="hub-page">
  <section class="hub-hero partner-hero"><div class="container"><p class="eyebrow">Become Partner</p><h1>Help exceptional founders<br />prove what <em>works.</em></h1><p>Rethinksoft partners bring capital, customers, infrastructure, and talent to technical founders at the moment it matters most.</p><a class="hub-primary" href="#partner-interest"><span>→</span>Start a conversation</a></div></section>
  <section class="hub-main container"><div class="hub-section-head"><div><p class="eyebrow">Ways to partner</p><h2>Useful support.<br />Clear outcomes.</h2></div><p>Every partnership should help a founder answer a real question, reach a real customer, or build a stronger company.</p></div><div class="partner-grid">{partnerships.map((item,index)=><article><span>{String(index+1).padStart(2,'0')}</span><h2>{item[0]}</h2><p>{item[1]}</p><small>PARTNERSHIP PATH</small></article>)}</div></section>
  <section class="hub-capture" id="partner-interest"><div class="container"><div><p class="eyebrow">Partner with Rethinksoft</p><h2>Bring something<br />founders can use.</h2><p>Share your email and we will send the partner brief when the W26 network opens.</p></div><form id="waitlist-form"><input class="hp" name="company" tabindex="-1" autocomplete="off" /><label for="partner-email">WORK EMAIL</label><div><input id="partner-email" name="email" type="email" placeholder="partner@company.com" required /><button type="submit"><span>→</span>REQUEST PARTNER BRIEF</button></div><p id="waitlist-note" aria-live="polite">We review partnership interest personally.</p></form></div></section>
</BaseLayout>
