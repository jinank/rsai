---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Rethinksoft | Build Your Startup. We Fund the Progress.';
const description = 'Rethinksoft backs AI-native technical founders with progressive capital, infrastructure, and distribution support.';
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const agents = [
  { code: '01', name: 'Founder', text: 'Execution history, technical capability, commitment, and founder-market fit.' },
  { code: '02', name: 'Market', text: 'Customer urgency, willingness to pay, timing, and reachable market size.' },
  { code: '03', name: 'Product', text: 'Live value, differentiation, activation, and evidence of repeated use.' },
  { code: '04', name: 'Technical', text: 'Architecture, security, code provenance, feasibility, and shipping velocity.' },
  { code: '05', name: 'Distribution', text: 'Channel access, customer acquisition tests, sales ability, and unfair reach.' },
  { code: '06', name: 'Traction', text: 'Verified users, revenue, growth, engagement, conversion, and retention.' },
];
const scoreFactors = [
  ['Founder execution', 15], ['Problem evidence', 12], ['Market', 8], ['Product', 8], ['Technical execution', 8],
  ['Distribution', 15], ['Traction', 15], ['Capital efficiency', 7], ['Differentiation', 5], ['Risk and integrity', 7],
];
const faqs = [
  { q: 'Is this an accelerator?', a: 'Foundry 01 is a focused capital experiment for technical founders with a working B2B product. We combine AI-assisted diligence, a human funding decision, one critical commercial experiment, and hands-on distribution support.' },
  { q: 'Do you take equity in the pilot?', a: 'No. The first four-founder pilot offers up to $1,000 in non-dilutive grant funding plus approved AI and cloud credits. Future investments may use a separate, clearly documented SAFE.' },
  { q: 'How quickly will I receive a decision?', a: 'Our target is a provisional evidence review within minutes and a human-reviewed decision within 24 hours after required evidence is available.' },
  { q: 'What happens if the experiment fails?', a: 'An honest negative result is useful. We evaluate the quality of execution and learning, then decide whether to continue, change the experiment, pause, or stop. Funding is not a reward for manufacturing positive results.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Rethinksoft', url: siteUrl },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Rethinksoft', url: siteUrl, description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---
<BaseLayout {title} {description} image="/og/home.png" {jsonLd} pageClass="home-page foundry-home">
  <section class="foundry-hero">
    <div class="foundry-grid" aria-hidden="true"></div>
    <div class="container foundry-hero-inner">
      <p class="foundry-kicker"><span class="foundry-kicker-mark" aria-hidden="true">R</span><span class="foundry-kicker-copy">Applications for Rethinksoft Foundry <strong>W26</strong> closing soon</span></p>
      <h1>Build your startup.<br /><em>We fund the progress.</em></h1>
      <p class="foundry-lede">Rethinksoft backs AI-native technical founders with progressive capital, infrastructure, and distribution support.</p>
      <div class="foundry-actions"><a class="foundry-primary" href="#apply">APPLY TO RETHINKSOFT FOUNDRY <span>↗</span></a><a class="foundry-secondary" href="#model">HOW FUNDING WORKS</a></div>
      <div class="foundry-preview" aria-label="Example Rethinksoft diligence result">
        <div class="preview-window">
          <div class="preview-bar"><span><i></i><i></i><i></i></span><small>foundry.rethinksoft.ai / review</small><b>LIVE</b></div>
          <div class="preview-body">
            <div class="preview-company"><span>CA</span><div><small>APPLICATION 004</small><strong>ConstructionProposal AI</strong><p>Working B2B product · 3 design partners · Pre-revenue</p></div></div>
            <div class="preview-score"><small>RETHINK SCORE</small><strong>81<span>/100</span></strong><b>CONDITIONAL</b></div>
            <div class="preview-agents"><span>FOUNDER <b>84</b></span><span>PRODUCT <b>86</b></span><span>DISTRIBUTION <b>62</b></span><span>TRACTION <b>70</b></span></div>
            <div class="preview-unlock"><div><small>NEXT PROOF POINT</small><strong>Convert 3 design partners into paying customers</strong></div><span>POTENTIAL UNLOCK&nbsp; $10K</span></div>
          </div>
        </div>
        <div class="preview-float preview-float-left"><span>✓</span><div><small>EVIDENCE VERIFIED</small><strong>GitHub + product live</strong></div></div>
        <div class="preview-float preview-float-right"><small>FIRST EXPERIMENT</small><strong>$1,000</strong><span>0% equity</span></div>
      </div>
      <div class="foundry-proof"><span><b>15 min</b> application</span><span><b>24 hr</b> decision target</span><span><b>$1K</b> first experiment</span><span><b>0%</b> pilot equity</span></div>
    </div>
  </section>

  <section class="foundry-story" id="thesis">
    <div class="container foundry-story-layout">
      <article class="story-card story-thesis reveal">
        <div class="story-card-head"><div><p class="foundry-section-code">01 / THE THESIS</p><h2>Software is cheaper to build.<br /><em>Capital should become smarter.</em></h2></div><p>Instead of making one large bet on a collection of assumptions, Rethinksoft funds the smallest credible experiment that can prove what should happen next.</p></div>
        <div class="story-equation" aria-label="Rethinksoft funding principle"><span>HIGH-RISK ASSUMPTION</span><b>×</b><span>SMALLEST CREDIBLE TEST</span><b>÷</b><span>CAPITAL REQUIRED</span><strong>= LEARNING PER DOLLAR</strong></div>
      </article>

      <div class="foundry-story-stack">
        <article class="story-card story-model reveal" id="model">
          <div class="story-card-head"><div><p class="foundry-section-code">02 / THE MODEL</p><h2>From working product<br />to verified demand.</h2></div><p>You have already built something. We help determine whether it deserves to become a company, then fund the next proof point.</p></div>
          <div class="story-step-grid">
            <div><span>01</span><b>↗</b><h3>Apply</h3><p>Show us the product, customer, evidence, and constraint in about 15 minutes.</p></div>
            <div><span>02</span><b>⌁</b><h3>Underwrite</h3><p>Specialized agents examine the founder, market, product, technology, distribution, and traction.</p></div>
            <div><span>03</span><b>81</b><h3>Understand</h3><p>Receive an explainable score, evidence map, red team case, and recommended next experiment.</p></div>
            <div><span>04</span><b>$</b><h3>Fund</h3><p>A human reviews the evidence and approves a small grant tied to one critical experiment.</p></div>
            <div><span>05</span><b>↑</b><h3>Progress</h3><p>Verified execution can unlock a larger investment and continued distribution support.</p></div>
          </div>
        </article>

        <article class="story-card story-diligence reveal" id="diligence">
          <div class="story-card-head"><div><p class="foundry-section-code">03 / AI DILIGENCE</p><h2>Seven perspectives.<br />One accountable decision.</h2></div><p>Specialized agents build independent cases, a red team argues against the investment, and an accountable human makes the final decision.</p></div>
          <div class="story-human"><span>H</span><div><strong>Human investment review</strong><p>Required before capital moves.</p></div><small>EVIDENCE REVIEW</small></div>
          <div class="story-agent-grid">{agents.map((agent) => <div><span>{agent.code}</span><h3>{agent.name} agent</h3><p>{agent.text}</p><small>ANALYSIS READY ✓</small></div>)}<div class="story-red-team"><span>07</span><h3>Red team</h3><p>Argues against the investment and identifies the assumptions most likely to break.</p><small>CHALLENGE ACTIVE</small></div></div>
        </article>

        <article class="story-card story-score reveal" id="score">
          <div class="story-card-head"><div><p class="foundry-section-code">04 / EXPLAINABLE UNDERWRITING</p><h2>A score that tells you<br />what to do next.</h2></div><p>Rethink Score is decision support, not an automatic verdict. You see the evidence, concerns, and next proof point.</p></div>
          <div class="story-score-layout">
            <div class="story-score-result"><div><span>RETHINK SCORE</span><small>PROVISIONAL</small></div><strong>81<em>/100</em></strong><p><b>CONDITIONAL</b> Strong product. Distribution evidence required.</p><div><span>NEXT PROOF POINT</span><p>Convert three design partners into paying customers.</p><small>POTENTIAL UNLOCK&nbsp; $10K TO $25K</small></div></div>
            <div><div class="score-bars">{scoreFactors.map(([name, weight]) => <div><span>{name}</span><i><b style={`width:${Number(weight) * 5.6}%`}></b></i><strong>{weight}</strong></div>)}</div><p class="score-note">Severe integrity, legal, security, or IP concerns override the numerical score.</p></div>
          </div>
        </article>

        <article class="story-card story-capital reveal" id="capital">
          <div class="story-card-head"><div><p class="foundry-section-code">05 / PROGRESSIVE CAPITAL</p><h2>Prove more.<br />Unlock more.</h2></div><p>Capital follows verified learning. Each stage answers the next important question without overfunding an untested assumption.</p></div>
          <div class="story-capital-grid"><div class="active"><span>STAGE 01</span><h3>Validate</h3><strong>$1K</strong><p>Test one critical customer or market assumption.</p><small>NON-DILUTIVE PILOT GRANT</small></div><div><span>STAGE 02</span><h3>Distribute</h3><strong>$10K</strong><p>Convert a working product into verified paying demand.</p><small>FUTURE SAFE INVESTMENT</small></div><div><span>STAGE 03</span><h3>Repeat</h3><strong>$25K</strong><p>Prove retention or a repeatable acquisition channel.</p><small>HUMAN INVESTMENT REVIEW</small></div><div><span>STAGE 04</span><h3>Scale</h3><strong>$100K+</strong><p>Concentrate capital behind demonstrated execution.</p><small>FOLLOW-ON CAPITAL</small></div></div>
          <p class="story-formula">Experiment priority = decision impact × uncertainty × speed ÷ cash required</p>
        </article>

        <article class="story-card story-fit reveal" id="fit">
          <div class="story-card-head"><div><p class="foundry-section-code">06 / WHO IT IS FOR</p><h2>Already building.<br /><em>Ready to prove it.</em></h2></div><p>We are looking for technical founders who can reach a real customer without months of additional product development.</p></div>
          <div class="story-fit-grid"><div><span>01</span><strong>One or two technical founders</strong><p>You can build and ship without outsourcing the core product.</p></div><div><span>02</span><strong>Working B2B software</strong><p>A customer can use the product today, even if the experience is still rough.</p></div><div><span>03</span><strong>Under $5K MRR</strong><p>You are early enough for a small experiment to change the trajectory.</p></div><div><span>04</span><strong>Customer access</strong><p>You have completed at least five genuine conversations and can charge within 30 days.</p></div><div><span>05</span><strong>Verifiable evidence</strong><p>You support claims with product, repository, user, and revenue evidence.</p></div></div>
          <a class="story-fit-cta" href="#apply"><span>→</span>CHECK YOUR FIT</a>
        </article>
      </div>
    </div>
  </section>

  <section class="pilot-section section" id="pilot"><div class="container reveal">
    <div class="pilot-banner"><div><p class="foundry-section-code">FOUNDRY 01 / THE PILOT</p><h2>Four founders.<br />One month.<br />No equity.</h2></div><div class="pilot-details"><p>We are testing whether Rethinksoft can help strong technical founders reach verified customer demand faster and more efficiently.</p><div><span><strong>4</strong> founders</span><span><strong>$1K</strong> grant each</span><span><strong>30</strong> days</span><span><strong>0%</strong> equity</span></div></div></div>
    <div class="pilot-kpi"><span>PRIMARY PILOT METRIC</span><strong>Verified new paying customers</strong><i>per $1,000 of Rethinksoft cost</i></div>
  </div></section>

  <section class="faq-section section" id="faq"><div class="container reveal"><div class="foundry-section-head"><div><p class="foundry-section-code">07 / QUESTIONS</p><h2>Clear terms.<br />No accelerator theatre.</h2></div><p>The first cohort is designed to test Rethinksoft as much as it tests the participating companies.</p></div><div class="foundry-faq">{faqs.map((item, index) => <details open={index === 0}><summary><span>0{index + 1}</span>{item.q}<i>+</i></summary><p>{item.a}</p></details>)}</div></div></section>

  <section class="foundry-apply" id="apply"><div class="container apply-layout reveal"><div><p class="foundry-section-code">FOUNDRY 01</p><h2>Your product is live.<br /><em>What should happen next?</em></h2><p>Join the early application list for the first four-founder Rethinksoft cohort.</p></div><form class="foundry-apply-form" id="waitlist-form"><input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" /><label for="email">WORK EMAIL</label><div><input id="email" name="email" type="email" placeholder="founder@startup.com" required /><button type="submit">REQUEST APPLICATION <span>↗</span></button></div><p id="waitlist-note" aria-live="polite">We will send the application brief when Foundry 01 opens. No spam.</p></form></div></section>
</BaseLayout>
