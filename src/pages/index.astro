---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductMark from '../components/ProductMark.astro';
import FreeToolCard from '../components/FreeToolCard.astro';
import { categoryEmoji, getApps, verdictCopy } from '../lib/apps';
import { getVoteCounts } from '../lib/db';
import { freeTools } from '../lib/freeTools';
import { launchBusinesses } from '../lib/businesses';

const apps = getApps();
const counts = getVoteCounts();
const ranked = apps.sort((a, b) => (counts[b.slug] || 0) - (counts[a.slug] || 0) || b.priceMonthly - a.priceMonthly);
const categories = [...new Set(apps.map((app) => app.category))].sort();
const homepageTools = [...freeTools.filter((item) => item.status === 'available'), ...freeTools.filter((item) => item.status === 'coming')].slice(0, 4);
const title = 'Rethinksoft | Start Your Software Business Today';
const description = 'Choose a launch-ready software business, make it yours, connect payments, and start selling. Host with Rethinksoft or own the complete source code.';
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Rethinksoft', url: siteUrl, potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Launch-ready software businesses', itemListElement: launchBusinesses.map((business, index) => ({ '@type': 'ListItem', position: index + 1, url: `${siteUrl}/#${business.slug}`, name: business.name })) },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Rethinksoft', url: siteUrl },
];
---
<BaseLayout {title} {description} image="/og/home.png" {jsonLd} pageClass="home-page business-home">
  <section class="hero business-hero">
    <div class="container business-hero-inner">
      <p class="eyebrow">Software businesses, ready to make yours</p>
      <h1>Pick it. Own it.<br /><em>Start selling.</em></h1>
      <p class="hero-lede">Choose a launch-ready software product. Add your brand and domain. Connect payments. Go live without months of building.</p>
      <div class="hero-actions"><a class="button business-primary" href="#businesses">EXPLORE BUSINESSES</a><a class="business-text-link" href="#ownership">SEE WHAT YOU OWN ↘</a></div>
      <div class="journey-rail" aria-label="Rethinksoft launch journey">{['Pick', 'Own', 'Launch', 'Sell', 'Grow'].map((step, index) => <span><b>{String(index + 1).padStart(2, '0')}</b>{step}</span>)}</div>
    </div>
  </section>

  <section class="section container business-catalog reveal" id="businesses">
    <div class="section-head"><div><p class="eyebrow">The founding collection</p><h2>Five businesses.<br />One clear starting point.</h2></div><p>Each product is a complete commercial application, not a design template. Pick the audience you understand and make the business distinctly yours.</p></div>
    <div class="business-grid">
      {launchBusinesses.map((business, index) => (
        <article class="business-card" id={business.slug}>
          <div class="business-card-top"><span class="business-icon">{business.icon}</span><span class="business-number">0{index + 1}</span></div>
          <p class="business-audience">{business.audience}</p><h3>{business.name}</h3><p>{business.description}</p>
          <div class="business-economics"><span>Your customer could pay</span><strong>{business.customerPrice}</strong></div>
          <ul>{business.includes.map((item) => <li>{item}</li>)}</ul>
          <div class="business-card-actions"><a href="#waitlist">REQUEST EARLY ACCESS</a><span>FROM ${business.licensePrice}</span></div>
        </article>
      ))}
    </div>
  </section>

  <section class="ownership-section section" id="ownership">
    <div class="container reveal">
      <div class="section-head centered-head"><div><p class="eyebrow">One product, two paths</p><h2>Host it or own every line.</h2></div><p>Choose convenience today without giving up ownership tomorrow.</p></div>
      <div class="ownership-grid">
        <article class="ownership-card cloud"><span class="ownership-label">RETHINK CLOUD</span><h3>We launch and run it.</h3><p>Add your brand, domain, and connected Stripe account. We handle deployment, updates, monitoring, and backups.</p><ul><li>Fast managed launch</li><li>Custom domain</li><li>Updates and backups</li><li>Connected payments</li></ul><strong>From $29/month</strong></article>
        <article class="ownership-card code"><span class="ownership-label">SOURCE CODE</span><h3>You take it anywhere.</h3><p>Download the complete application with commercial-use rights. Modify it, self-host it, and keep full control.</p><ul><li>Complete source code</li><li>Commercial license</li><li>Setup documentation</li><li>No hidden revenue tracking</li></ul><strong>From $199 one time</strong></article>
      </div>
    </div>
  </section>

  <section class="section container lifecycle reveal" id="how-it-works">
    <div class="section-head"><div><p class="eyebrow">The Rethinksoft lifecycle</p><h2>From choice to customers.</h2></div><p>The product is already built. Your job is to choose a market, shape the offer, launch, and learn.</p></div>
    <div class="lifecycle-grid">
      <article><span>01</span><h3>Pick</h3><p>Choose a software business and audience you understand.</p></article>
      <article><span>02</span><h3>Own</h3><p>Add your name, brand, colors, pricing, and positioning.</p></article>
      <article><span>03</span><h3>Launch</h3><p>Use Rethink Cloud or deploy the source code yourself.</p></article>
      <article><span>04</span><h3>Sell</h3><p>Connect payments and start accepting real customers.</p></article>
      <article><span>05</span><h3>Grow</h3><p>Add SEO, content, outreach, and paid acquisition when ready.</p></article>
    </div>
  </section>

  <section class="section container reveal" id="directory-preview">
    <div class="section-head"><div><p class="eyebrow">Research the opportunity</p><h2>Explore proven software markets.</h2></div><p>Compare familiar products, pricing, scope, and open source foundations before choosing what to sell.</p></div>
    <div class="search-shell market-search"><label class="sr-only" for="app-search">Search software markets</label><input class="hero-search" id="app-search" type="search" placeholder="Search markets, products, or categories" autocomplete="off" /></div>
    <div class="chips" aria-label="Filter by category"><button class="chip active" type="button" data-category="all">ALL</button>{categories.map((category) => <button class="chip" type="button" data-category={category.toLowerCase()}>{categoryEmoji[category] || '◈'} {category.toUpperCase()}</button>)}</div>
    <div class="table-shell market-table">
      <div class="list-header"><span>RANK</span><span>MARKET</span><span>CATEGORY</span><span>REFERENCE</span><span>SCOPE</span><span>BUILT</span><span>DETAILS</span></div>
      <div id="app-list">{ranked.map((app, index) => (
        <div class="app-row" data-name={`${app.name} ${app.domain}`.toLowerCase()} data-category={app.category.toLowerCase()}>
          <span class="rank">{String(index + 1).padStart(2, '0')}</span><span class="app-id"><ProductMark name={app.name} domain={app.domain} /><a href={`/${app.slug}`}>{app.name}</a></span><span class="category">{categoryEmoji[app.category]} {app.category}</span><span class="price">${app.priceMonthly}/mo</span><span class="scope-cell"><span class:list={["verdict", `verdict-${app.verdict}`]}>{verdictCopy[app.verdict].short}</span></span><span class="votes">{counts[app.slug] || 0}</span><a class="demo-button" href={`/${app.slug}`} aria-label={`Explore ${app.name}`}>EXPLORE ↗</a>
        </div>
      ))}</div>
      <div class="empty-state" id="empty-state">No matching markets found.</div>
    </div>
    <a class="tools-view-all" href="/directory">VIEW THE FULL DIRECTORY ↗</a>
  </section>

  <section class="pricing-section business-pricing section" id="pricing">
    <div class="container reveal">
      <div class="section-head centered-head"><div><p class="eyebrow">Simple, transparent economics</p><h2>Own the software. Pay for what helps.</h2></div><p>No subscription required to retain source code you already purchased.</p></div>
      <div class="revenue-grid">
        <article><span>01</span><p class="pricing-name">Software License</p><div class="pricing-price"><strong>$199</strong><span>one time, from</span></div><p>Complete source code, commercial-use rights, documentation, and self-hosting freedom.</p><a href="#waitlist">BROWSE FOUNDING PRODUCTS ↗</a></article>
        <article class="featured"><span>02</span><p class="pricing-name">Rethink Cloud</p><div class="pricing-price"><strong>$29</strong><span>/ month, from</span></div><p>Managed hosting, deployment, updates, backups, monitoring, and domain support.</p><a href="#waitlist">JOIN EARLY ACCESS ↗</a></article>
        <article><span>03</span><p class="pricing-name">Rethink Growth</p><div class="pricing-price"><strong>$299</strong><span>/ month, from</span></div><p>SEO, AEO, content, social, outreach, lead generation, and acquisition support.</p><a href="#waitlist">TALK ABOUT GROWTH ↗</a></article>
      </div>
      <p class="pricing-note">Cloud commerce fees will be disclosed clearly. Self-hosted products have no hidden transaction tracking.</p>
    </div>
  </section>

  <section class="home-tools section container reveal"><div class="section-head"><div><p class="eyebrow">Useful before you buy</p><h2>Free tools for builders.</h2></div><p>Research, audit, create, and validate your next business with practical tools.</p></div><div class="free-tools-grid home-tools-grid">{homepageTools.map((item) => <FreeToolCard {item} compact />)}</div><a class="tools-view-all" href="/tools">EXPLORE ALL FREE TOOLS ↗</a></section>

  <section class="waitlist reveal" id="waitlist"><div class="container wait-card"><div><p class="eyebrow">Founding access</p><h2>Which business<br />would you launch?</h2></div><div><p>Join the founding list. Tell us which product you want and whether you prefer managed hosting or complete source-code ownership.</p><form class="wait-form" id="waitlist-form"><input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" /><label class="sr-only" for="email">Email address</label><input id="email" name="email" type="email" placeholder="founder@yourcompany.com" required /><button class="button" type="submit">REQUEST ACCESS ↗</button></form><p class="form-note" id="waitlist-note" aria-live="polite">No spam. One useful update when founding products are ready.</p></div></div></section>
</BaseLayout>
