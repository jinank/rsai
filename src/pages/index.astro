---
import BaseLayout from '../layouts/BaseLayout.astro';
import { opportunities } from '../lib/opportunities';

const title = 'Start Your Software Business | Rethinksoft';
const description = 'Discover, validate, build, launch, and grow a software business with one focused operating system for software entrepreneurs.';
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const featured = opportunities.slice(0, 3);
const journey = [
  { n: '01', glyph: '⌕', name: 'Discover', text: 'Find researched opportunities or bring the idea already on your mind.' },
  { n: '02', glyph: '✓', name: 'Validate', text: 'Understand the customer, market, risks, and evidence required before you overbuild.' },
  { n: '03', glyph: '⌁', name: 'Build', text: 'Turn the opportunity into a focused specification for your preferred AI coding tools.' },
  { n: '04', glyph: '↗', name: 'Launch', text: 'Connect the business basics, go live, and move directly into customer acquisition.' },
  { n: '05', glyph: '↑', name: 'Grow', text: 'Run weekly distribution experiments and always know what deserves attention next.' },
];
const growthChannels = [
  ['01', 'SEO + AEO', 'Create high-intent pages that answer the questions buyers are already asking.'],
  ['02', 'Founder-led sales', 'Build a useful prospect list, reach out personally, and learn from every objection.'],
  ['03', 'Content', 'Turn customer evidence and product insight into credible founder distribution.'],
  ['04', 'Partnerships', 'Reach customers through communities, complementary products, and trusted operators.'],
  ['05', 'Activation', 'Improve the path from first visit to first value before buying more traffic.'],
  ['06', 'Retention', 'Find the repeated outcome that makes customers return and recommend the product.'],
];
const scoreFactors = [['Product', 84], ['Market', 76], ['Distribution', 48], ['Traction', 59], ['Execution', 82]];
const faqs = [
  { q: 'Is Rethinksoft another AI app builder?', a: 'No. Rethinksoft works around the coding tools. It helps you choose an opportunity, validate demand, define the right product, launch it, find customers, and decide what to do next.' },
  { q: 'Do I need to have a software idea already?', a: 'No. You can explore researched software opportunities or start with your own idea. Both paths lead into the same validation and Founder OS workflow.' },
  { q: 'Can I use Codex, Claude Code, Cursor, or my own developers?', a: 'Yes. Rethinksoft is build-tool agnostic. Existing product blueprints include specifications and open-source foundations you can use with the coding workflow you prefer.' },
  { q: 'Does Rethinksoft fund companies?', a: 'Funding is not the core product and Rethinksoft does not promise capital. Founders build traction first. Investor readiness, introductions, and future funding options can become available later.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Rethinksoft', url: siteUrl, potentialAction: { '@type': 'SearchAction', target: `${siteUrl}/opportunities?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Rethinksoft', url: siteUrl, description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---
<BaseLayout {title} {description} image="/og/home.png" {jsonLd} pageClass="home-page foundry-home entrepreneurship-home">
  <section class="foundry-hero">
    <div class="foundry-grid" aria-hidden="true"></div>
    <div class="container foundry-hero-inner">
      <p class="foundry-kicker"><span class="foundry-kicker-mark" aria-hidden="true">R</span><span class="foundry-kicker-copy">THE OPERATING SYSTEM FOR <strong>SOFTWARE ENTREPRENEURS</strong></span></p>
      <h1>Start your<br /><em>software business.</em></h1>
      <p class="foundry-lede">Discover an opportunity. Validate the market. Build with AI. Launch your product. Find customers. Everything you need to go from idea to revenue.</p>
      <div class="foundry-actions"><a class="foundry-primary" href="/start">START A BUSINESS <span>↗</span></a><a class="foundry-secondary" href="/opportunities">EXPLORE OPPORTUNITIES</a></div>
      <div class="foundry-preview" aria-label="Example Rethinksoft Founder OS workspace">
        <div class="preview-window">
          <div class="preview-bar"><span><i></i><i></i><i></i></span><small>founder.rethinksoft.com / careerforge</small><b>LIVE</b></div>
          <div class="preview-body">
            <div class="preview-company"><span>CF</span><div><small>FOUNDER OS · RECRUITING</small><strong>CareerForge AI</strong><p>AI interview coaching · 41 customers · $840 MRR</p></div></div>
            <div class="preview-score"><small>RETHINK SCORE</small><strong>74<span>/100</span></strong><b>PROGRESSING</b></div>
            <div class="preview-agents"><span>PRODUCT <b>88</b></span><span>DISTRIBUTION <b>61</b></span><span>REVENUE <b>67</b></span><span>CONSISTENCY <b>82</b></span></div>
            <div class="preview-unlock"><div><small>NEXT 7 DAYS</small><strong>Stop adding features. Interview 10 active job seekers.</strong></div><span>NEXT MILESTONE&nbsp; $1K MRR</span></div>
          </div>
        </div>
        <div class="preview-float preview-float-left"><span>✓</span><div><small>WEEKLY PLAN READY</small><strong>5 focused actions</strong></div></div>
        <div class="preview-float preview-float-right"><small>MRR PROGRESS</small><strong>84%</strong><span>to next milestone</span></div>
      </div>
      <div class="foundry-proof"><span><b>01</b> Discover</span><span><b>02</b> Validate</span><span><b>03</b> Launch</span><span><b>04</b> Grow</span></div>
    </div>
  </section>

  <section class="foundry-story" id="thesis">
    <div class="container foundry-story-layout">
      <article class="story-card story-thesis reveal">
        <div class="story-card-head"><div><p class="foundry-section-code">01 / THE THESIS</p><h2>Building software is easier.<br /><em>Building a business is not.</em></h2></div><p>AI has compressed the cost of shipping code. It has not solved opportunity selection, customer evidence, positioning, distribution, revenue, or founder focus.</p></div>
        <div class="story-equation"><span>RIGHT OPPORTUNITY</span><b>×</b><span>USEFUL PRODUCT</span><b>×</b><span>DISTRIBUTION</span><strong>= SOFTWARE BUSINESS</strong></div>
      </article>

      <div class="foundry-story-stack">
        <article class="story-card story-model reveal" id="journey">
          <div class="story-card-head"><div><p class="foundry-section-code">02 / HOW IT WORKS</p><h2>From an idea<br />to verified revenue.</h2></div><p>Rethinksoft connects the stages that generic AI builders leave disconnected.</p></div>
          <div class="story-step-grid">{journey.map((step) => <div><span>{step.n}</span><b>{step.glyph}</b><h3>{step.name}</h3><p>{step.text}</p></div>)}</div>
        </article>

        <article class="story-card story-diligence opportunity-home reveal" id="discover">
          <div class="story-card-head"><div><p class="foundry-section-code">03 / EXPLORE SOFTWARE BUSINESSES</p><h2>Start with a problem<br />worth solving.</h2></div><p>Browse serious opportunities with a clear customer, business model, validation path, and honest risk profile.</p></div>
          <div class="home-opportunity-grid">{featured.map((item) => <a href={`/start?opportunity=${item.slug}`}><span>{item.category}</span><h3>{item.name}</h3><p>{item.summary}</p><div><small>OPPORTUNITY SCORE</small><strong>{item.score}<em>/100</em></strong></div><b>START THIS BUSINESS ↗</b></a>)}</div>
          <a class="story-fit-cta" href="/opportunities"><span>→</span>EXPLORE ALL OPPORTUNITIES</a>
        </article>

        <article class="story-card story-score reveal" id="validate">
          <div class="story-card-head"><div><p class="foundry-section-code">04 / VALIDATE BEFORE YOU BUILD</p><h2>Know what must be true<br /><em>before writing more code.</em></h2></div><p>The Rethink Opportunity Score turns an interesting idea into an evidence plan.</p></div>
          <div class="story-score-layout">
            <div class="story-score-result"><div><span>OPPORTUNITY SCORE</span><small>AI INTERVIEW COACH</small></div><strong><i data-countup="82">82</i><em>/100</em></strong><p><b>STRONG</b> Clear pain, practical MVP, existing spend, and a reachable customer.</p><div><span>VALIDATE FIRST</span><p>Interview 10 active job seekers and test a $19 monthly offer.</p><small>DECISION TARGET&nbsp; 20 QUALIFIED SIGNUPS</small></div></div>
            <div class="validation-lists"><section><h3>Why this could work</h3><ul><li>Clear customer pain</li><li>Focused MVP scope</li><li>Existing alternatives prove spend</li><li>Strong SEO opportunity</li></ul></section><section><h3>Biggest risks</h3><ul><li>Crowded market</li><li>Differentiation needs focus</li><li>Retention after job placement</li></ul></section></div>
          </div>
        </article>

        <article class="story-card story-capital reveal" id="launch">
          <div class="story-card-head"><div><p class="foundry-section-code">05 / BUILD AND LAUNCH</p><h2>Use AI to build.<br />Keep ownership.</h2></div><p>Rethinksoft defines the business and product. Your preferred coding tools turn the specification into software.</p></div>
          <div class="story-capital-grid"><div class="active"><span>STEP 01</span><h3>Scope</h3><strong>PRD</strong><p>User flows, data, authentication, payments, AI requirements, and a launch checklist.</p><small>FOCUSED MVP</small></div><div><span>STEP 02</span><h3>Build</h3><strong>AI</strong><p>Use Codex, Claude Code, Cursor, open-source foundations, or your own team.</p><small>TOOL AGNOSTIC</small></div><div><span>STEP 03</span><h3>Connect</h3><strong>01</strong><p>Add your brand, domain, payments, email, analytics, and operating stack.</p><small>BUSINESS READY</small></div><div><span>STEP 04</span><h3>Launch</h3><strong>↗</strong><p>Go live, establish a baseline, and immediately begin the first customer plan.</p><small>START DISTRIBUTION</small></div></div>
          <p class="story-formula">The product is not finished when it deploys. The business starts when customers arrive.</p>
        </article>

        <article class="story-card story-diligence reveal" id="growth">
          <div class="story-card-head"><div><p class="foundry-section-code">06 / GET YOUR FIRST CUSTOMERS</p><h2>Distribution becomes<br />part of the product.</h2></div><p>Rethinksoft creates a focused customer acquisition plan and turns it into weekly execution.</p></div>
          <div class="story-agent-grid">{growthChannels.map(([code, name, text]) => <div><span>{code}</span><h3>{name}</h3><p>{text}</p><small>GROWTH CHANNEL</small></div>)}</div>
        </article>

        <article class="story-card story-score reveal" id="founder-os">
          <div class="story-card-head"><div><p class="foundry-section-code">07 / FOUNDER OS</p><h2>Always know<br /><em>what to do next.</em></h2></div><p>Your Rethink Score combines company health, execution, customer evidence, and weekly progress into one useful decision system.</p></div>
          <div class="story-score-layout">
            <div class="story-score-result"><div><span>RETHINK SCORE</span><small>CAREERFORGE AI</small></div><strong><i data-countup="74">74</i><em>/100</em></strong><p><b>PROGRESSING</b> Strong product. Distribution is the current constraint.</p><div><span>AI RECOMMENDATION</span><p>Stop building features this week. Talk to 20 target customers.</p><small>NEXT MILESTONE&nbsp; $1K MRR</small></div></div>
            <div><div class="score-bars">{scoreFactors.map(([name, value]) => <div><span>{name}</span><i><b style={`width:${value}%`}></b></i><strong>{value}</strong></div>)}</div><div class="founder-os-actions"><span>✓ FIRST CUSTOMER</span><span>✓ $500 MRR</span><span>84% TO $1K MRR</span></div><a class="story-fit-cta" href="/start"><span>→</span>CREATE YOUR FOUNDER OS</a></div>
          </div>
        </article>

        <article class="story-card story-ecosystem reveal" id="ecosystem">
          <div class="story-card-head"><div><p class="foundry-section-code">08 / THE ECOSYSTEM</p><h2>Support that grows<br />with the company.</h2></div><p>Use only the layer you need now. Unlock deeper support after the business earns it.</p></div>
          <div class="ecosystem-grid"><a href="/deals"><span>01</span><h3>Rethink Deals</h3><p>Reduce costs with relevant AI, cloud, analytics, email, sales, and developer benefits.</p><b>EXPLORE DEALS ↗</b></a><a href="/partner"><span>02</span><h3>Rethink Growth</h3><p>Optional managed SEO, AEO, content, outbound, conversion, and growth support.</p><b>GROW WITH RETHINKSOFT ↗</b></a><div><span>03</span><h3>Funding readiness</h3><p>Build traction first. Capital comes next through preparation, introductions, and future eligibility.</p><b>TRACTION REQUIRED</b></div></div>
        </article>
      </div>
    </div>
  </section>

  <section class="pilot-section section" id="philosophy"><div class="container reveal">
    <div class="pilot-banner"><div><p class="foundry-section-code">THE RETHINKSOFT PHILOSOPHY</p><h2>Starting has never<br />been easier.<br /><em>Succeeding takes work.</em></h2></div><div class="pilot-details"><p>Rethinksoft does not promise instant revenue or replace founder judgment. It reduces uncertainty, organizes execution, and keeps every week connected to customers.</p><div><span><strong>Discover</strong> the opportunity</span><span><strong>Validate</strong> the evidence</span><span><strong>Launch</strong> the product</span><span><strong>Grow</strong> the company</span></div></div></div>
    <div class="pilot-kpi"><span>THE NORTH STAR</span><strong>Make software entrepreneurship accessible to everyone</strong></div>
  </div></section>

  <section class="faq-section section" id="faq"><div class="container reveal"><div class="foundry-section-head"><div><p class="foundry-section-code">09 / QUESTIONS</p><h2>Build the business.<br />Not only the app.</h2></div><p>Rethinksoft sits around the tools you already use and connects product work to market evidence, customers, and growth.</p></div><div class="foundry-faq">{faqs.map((item, index) => <details open={index === 0}><summary><span>0{index + 1}</span>{item.q}<i>+</i></summary><p>{item.a}</p></details>)}</div></div></section>

  <section class="foundry-apply" id="start"><div class="container apply-layout reveal"><div><p class="foundry-section-code">START YOUR SOFTWARE BUSINESS</p><h2>Choose the opportunity.<br /><em>Make the next move.</em></h2><p>Bring an idea or start from a researched opportunity. Create a private Founder OS workspace in about three minutes.</p></div><div class="final-action-stack"><a class="foundry-primary" href="/start">START A BUSINESS <span>↗</span></a><a class="foundry-secondary" href="/opportunities">EXPLORE OPPORTUNITIES</a><p>No application, payment, or equity required for the first workspace.</p></div></div></section>
</BaseLayout>
