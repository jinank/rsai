---
import BaseLayout from '../layouts/BaseLayout.astro';

const toolNames = ['Vapi','Roboflow','AgentMail','Bolna','Firecrawl','Tavus','Deepgram','Supabase','Langfuse','Gumloop','Browser Use','Greptile'];
const faqs = [
  ['How do I qualify?', 'RS Deals is being designed for verified technical founders, accepted Foundry companies, students in approved programs, and selected Rethinksoft partners.'],
  ['What deals are available?', 'The initial stack focuses on cloud infrastructure, AI APIs, developer tooling, data, automation, and product operations.'],
  ['How long does access last?', 'Access periods vary by partner and may require periodic eligibility verification.'],
  ['Want to add your tool?', 'Technology companies can apply through our partner page and propose a meaningful founder benefit.'],
  ['How do I activate my deals?', 'Eligible members will receive a private activation path for each approved partner offer.'],
  ['Have other questions?', 'Contact Rethinksoft through the partner page and tell us what you are building or which benefit you need.'],
];

const title = 'RS Deals | Founder Credits and Startup Benefits';
const description = 'RS Deals brings cloud credits, AI API benefits, and startup tools together for eligible Rethinksoft founders and partners.';
---
<BaseLayout {title} {description} pageClass="hub-page deals-page compact-deals">
  <main class="compact-deals-main container">
    <section class="compact-deals-hero">
      <h1>RS Deals</h1>
      <h2>Over <strong>$25,000</strong> in potential AI and cloud benefits</h2>
      <p>Rethinksoft is assembling essential infrastructure and developer offers for founders building AI-native software.</p>
      <div class="compact-deals-status">Applications open soon. Partner approval and final offer terms apply.</div>
      <a class="compact-deals-button" href="/#apply">Request access</a>
    </section>

    <section class="compact-included" aria-labelledby="included-heading">
      <h2 id="included-heading">What is included</h2>
      <div class="compact-deal-grid">
        <article>
          <h3>Cloud credits</h3>
          <div class="compact-deal-row"><span class="compact-logo">AWS</span><strong>Amazon Web Services</strong><b>$10,000</b></div>
          <div class="compact-deal-row"><span class="compact-logo blue">AZ</span><strong>Microsoft Azure</strong><b>$10,000</b></div>
        </article>
        <article>
          <h3>AI API credits</h3>
          <div class="compact-deal-row"><span class="compact-logo dark">AI</span><strong>OpenAI</strong><b>$1,000</b></div>
          <div class="compact-deal-row"><span class="compact-logo warm">AN</span><strong>Anthropic</strong><b>$500</b></div>
        </article>
        <article>
          <h3>AI developer tools</h3>
          <p>Voice, automation, search, video, data, deployment, and more.</p>
          <div class="compact-tool-list" aria-label="Tools in the partner directory">{toolNames.map((tool) => <span title={tool}>{tool.slice(0, 2).toUpperCase()}</span>)}</div>
        </article>
      </div>
      <p class="compact-disclaimer">Offer values are program targets and remain subject to availability, eligibility, and partner approval.</p>
    </section>

    <section class="compact-faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">FAQ</h2>
      <div>{faqs.map(([question, answer]) => <details><summary>{question}<i>+</i></summary><p>{answer}</p></details>)}</div>
    </section>

    <div class="compact-partner"><span>Want to offer a founder benefit?</span><a href="/partner">Become an RS Deals partner →</a></div>
  </main>
</BaseLayout>
