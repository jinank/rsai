---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNews } from '../lib/news';

const items = getNews();
const categories = [...new Set(items.map((item) => item.category))].sort();
const title = 'Latest AI Tools and Builder News | Rethinksoft';
const description = 'A curated feed of new AI products, coding agents, open source tools, and practical releases worth knowing about.';
const dateLabel = (date: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
const jsonLd = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Latest AI Tools and Builder News', itemListElement: items.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.title, url: item.url })) };
---
<BaseLayout {title} {description} {jsonLd} pageClass="resource-page news-page">
  <section class="resource-hero news-hero"><div class="container"><p class="eyebrow">The builder signal</p><h1>Useful tools.<br />No noisy <em>feed.</em></h1><p>Fresh AI products, open source releases, and builder tools selected for people who make software.</p></div></section>
  <div class="container resource-main" data-resource-directory>
    <div class="resource-toolbar"><label><span>Search the news</span><input type="search" placeholder="Search tools, companies, or categories" data-resource-search /></label><p><strong data-resource-count>{items.length}</strong> stories</p></div>
    <div class="resource-chips" aria-label="News categories"><button class="active" type="button" data-resource-category="all">All</button>{categories.map((category) => <button type="button" data-resource-category={category.toLowerCase()}>{category}</button>)}</div>
    <div class="news-grid" data-resource-list>{items.map((item) => <article class="news-card" data-resource-item data-search={`${item.title} ${item.summary} ${item.category} ${item.source}`.toLowerCase()} data-categories={item.category.toLowerCase()}><div class="news-card-meta"><span>{item.category}</span><time datetime={item.date}>{dateLabel(item.date)}</time></div><h2>{item.title}</h2><p>{item.summary}</p><a href={item.url} target="_blank" rel="noopener">Read at {item.source} ↗</a></article>)}</div>
    <p class="resource-empty" data-resource-empty hidden>No stories match those filters.</p>
    <aside class="news-note"><strong>How we curate</strong><p>We link to original product pages and primary announcements whenever possible. Inclusion is editorial, not sponsored.</p></aside>
  </div>
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-resource-directory]');
      if (!root) return;
      const search = root.querySelector('[data-resource-search]');
      const items = [...root.querySelectorAll('[data-resource-item]')];
      const buttons = [...root.querySelectorAll('[data-resource-category]')];
      const count = root.querySelector('[data-resource-count]');
      const empty = root.querySelector('[data-resource-empty]');
      let category = 'all';
      const filter = () => {
        const query = search.value.trim().toLowerCase();
        let visible = 0;
        items.forEach((item) => {
          const show = (!query || item.dataset.search.includes(query)) && (category === 'all' || item.dataset.categories === category);
          item.hidden = !show;
          if (show) visible += 1;
        });
        count.textContent = String(visible);
        empty.hidden = visible !== 0;
      };
      search.addEventListener('input', filter);
      buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.resourceCategory; buttons.forEach((item) => item.classList.toggle('active', item === button)); filter(); }));
    })();
  </script>
</BaseLayout>
