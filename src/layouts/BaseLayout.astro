---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/global.css';
import '../styles/redesign.css';
import '../styles/detail-gojiberry.css';
import '../styles/home-gojiberry.css';
import '../styles/resources.css';
import '../styles/responsive.css';
import '../styles/palette.css';
import '../styles/holaos-inspired.css';
import '../styles/foundry.css';
import '../styles/foundry-goji.css';
import '../styles/hub-pages.css';
import '../styles/story-refine.css';
import '../styles/sprint-setup.css';
import '../styles/pivot.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  pageClass?: string;
  noindex?: boolean;
}
const { title, description, image = '/og/home.png', jsonLd, pageClass, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={pageClass}>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Rethinksoft home"><span class="brand-wordmark"><span>Rethink</span><em>soft</em></span></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-navigation" aria-label="Primary navigation">
        <a href="/#journey">How it works</a>
        <a href="/opportunities">Software</a>
        <a href="/#pricing">Pricing</a>
        <a href="/resources">Resources</a>
        <a href="/deals">RS Deals</a>
        <a class="mobile-apply-link" href="/opportunities">Choose software</a>
      </nav>
      <a class="header-apply-cta" href="/opportunities"><span>→</span>Choose software</a>
    </header>
    <main><slot /></main>
    <footer class="site-footer reveal">
      <div class="footer-cta">
        <div><p class="eyebrow">YOUR SOFTWARE BUSINESS</p><h2>Pick the product.<br />Make it yours.</h2></div>
        <a href="/opportunities"><span>→</span>Choose software</a>
      </div>
      <div class="footer-grid">
        <div class="footer-brand"><a class="brand" href="/" aria-label="Rethinksoft home"><span class="brand-wordmark"><span>Rethink</span><em>soft</em></span></a><p>Ready-to-launch software businesses. We manage the technology. You build the customer base.</p></div>
        <div><p class="eyebrow">Explore</p><a href="/opportunities">Software Businesses</a><a href="/#journey">How It Works</a><a href="/#pricing">Pricing</a><a href="/company-directory">Company Directory</a><a href="/resources">Resources</a></div>
        <div><p class="eyebrow">Launch</p><a href="/start">Set Up Your Business</a><a href="/deals">RS Deals</a><a href="/tools">Free Tools</a><a href="/open-source">Open Source</a><a href="/partner">Become a Partner</a></div>
        <div><p class="eyebrow">Network</p><a href="/showcase">Founder Showcase</a><a href="/partner">Become Partner</a><a href="/tools">Free Tools</a><a href="/jobs">Startup Jobs</a><a href="/sell">Submit a Product</a></div>
      </div>
      <div class="footer-line"><span>© 2026 Rethinksoft</span><span>We build the software. You build the business.</span><span><i></i> All systems operational</span></div>
    </footer>
    <script is:inline src="/site.js"></script>
  </body>
</html>
