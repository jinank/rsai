---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/700.css';
import '../styles/global.css';
import '../styles/redesign.css';
import '../styles/detail-gojiberry.css';
import '../styles/home-gojiberry.css';
import '../styles/resources.css';
import '../styles/responsive.css';
import '../styles/palette.css';
import '../styles/holaos-inspired.css';
import '../styles/foundry.css';
import '../styles/foundry-goji.css';
import '../styles/hub-pages.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  pageClass?: string;
}
const { title, description, image = '/og/home.png', jsonLd, pageClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={pageClass}>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Rethinksoft home"><span class="brand-wordmark"><span>Rethink</span><em>soft</em></span></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-navigation" aria-label="Primary navigation">
        <a href="/#model">How it works</a>
        <a href="/#score">Rethink Score</a>
        <a href="/#apply">Apply now</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer reveal">
      <div class="footer-cta">
        <div><p class="eyebrow">Rethinksoft Foundry</p><h2>Build the proof.<br />Fund the progress.</h2></div>
        <a href="/#apply"><span>→</span>Apply to Foundry</a>
      </div>
      <div class="footer-grid">
        <div class="footer-brand"><a class="brand" href="/" aria-label="Rethinksoft home"><span class="brand-wordmark"><span>Rethink</span><em>soft</em></span></a><p>Progressive capital, startup intelligence, and practical infrastructure for AI-native technical founders.</p></div>
        <div><p class="eyebrow">Discover</p><a href="/company-directory">Company Directory</a><a href="/news">Latest Startup News</a><a href="/jobs">Startup Jobs</a><a href="/resources">Resources</a></div>
        <div><p class="eyebrow">Foundry</p><a href="/#model">How it works</a><a href="/#score">Rethink Score</a><a href="/#pilot">Foundry W26</a><a href="/#apply">Apply now</a></div>
        <div><p class="eyebrow">Connect</p><a href="/partner">Become Partner</a><a href="/tools">Free Tools</a><a href="/open-source">Open Source</a><a href="/sell">Submit a Product</a></div>
      </div>
      <div class="footer-line"><span>© 2026 Rethinksoft</span><span>Built for technical founders</span><span><i></i> All systems operational</span></div>
    </footer>
    <script is:inline src="/site.js"></script>
  </body>
</html>
